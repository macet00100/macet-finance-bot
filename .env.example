# ========================================================
# MACET FINANCE BOT - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (.env)
# ========================================================

# 1. Telegram Bot Token (Tạo bot và lấy token từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Thông tin Kênh Telegram (Thêm Bot vào Kênh với quyền Administrator)
# Channel ID có dạng -100xxxxxxxxxx hoặc username công khai (@your_channel)
TELEGRAM_CHANNEL_ID=@your_channel_or_channel_id
TELEGRAM_CHANNEL_USERNAME=@your_channel_username

# 3. Google Gemini AI API Configuration
# Lấy API key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. Tần suất tự động quét tin tức CafeF RSS (Đơn vị: Giây, mặc định 300 = 5 phút)
AUTO_NEWS_INTERVAL_SECONDS=300
